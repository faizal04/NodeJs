extends EmailBase

block content
  p Hi #{firstName},
  p We received a request to verify your account. Please use the One-Time Password (OTP) below to complete your verification:
  
  table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0', style='margin: 30px 0;')
    tbody
      tr
        td(align='center', style='padding: 20px; background-color: #f4f4f4; border-radius: 5px;')
          p(style='margin: 0; font-size: 32px; font-weight: bold; letter-spacing: 5px; color: #55c57a;') #{otp}
  
  p This OTP is valid for 10 minutes only. Please do not share this code with anyone.
  
  p If you did not request this verification, please ignore this email or contact our support team immediately.
  
  p Stay safe!
  p - Faisal Harray, CEO
