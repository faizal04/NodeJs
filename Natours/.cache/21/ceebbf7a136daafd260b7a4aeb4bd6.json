,{"generated":{"line":117,"column":0},"source":"login.js","original":{"line":25,"column":19}},{"generated":{"line":118,"column":0},"source":"login.js","original":{"line":25,"column":19}},{"generated":{"line":118,"column":3},"source":"login.js","original":{"line":25,"column":7}}],"sources":{"login.js":"import axios from 'axios';\r\nimport { showAlert } from './alert';\r\nexport const login = async function (email, password) {\r\n  try {\r\n    const res = await axios({\r\n      method: 'POST',\r\n      url: 'http://localhost:3000/api/v1/users/login',\r\n      data: {\r\n        email,\r\n        password,\r\n      },\r\n    });\r\n    console.log(res);\r\n    if (res.data.status === 'success') {\r\n      showAlert('success', 'logged in succesfuly');\r\n      window.setTimeout(() => {\r\n        location.assign('/');\r\n      }, 1500);\r\n    }\r\n  } catch (err) {\r\n    showAlert('error', err.response.data.message);\r\n  }\r\n};\r\n\r\nexport const logout = async () => {\r\n  try {\r\n    console.log('reached axios');\r\n    const result = await axios({\r\n      method: 'GET',\r\n      url: 'http://localhost:3000/api/v1/users/logout',\r\n    });\r\n    if (result.data.status === 'success') {\r\n      showAlert('success', 'Logout Successfully');\r\n      location.reload(true);\r\n    }\r\n  } catch (err) {\r\n    showAlert('error', result.data.message);\r\n  }\r\n};\r\n"},"lineCount":null}},"error":null,"hash":"ad1bf2dc60f9c2ed2e1d5552540b6c31","cacheData":{"env":{}}}